# escape_from_blockov 최상위 .gitignore
# (Unity 관련 규칙은 client/escape_from_blockov/.gitignore 에 있음)

# Visual Studio / MSBuild
.vs/
**/x64/*
# 서버 실행 파일은 올린다 (clone 후 start_server.bat 으로 바로 실행)
!server/GameServer/x64/Release/
server/GameServer/x64/Release/*
!server/GameServer/x64/Release/GameServer.exe
*.vcxproj.user
server/GameServer/GameServer/

# Unity WebGL 빌드 시 생성되는 Burst 산출물
client/escape_from_blockov/Data/

# 서버 실행 산출물 (로그, 크래시 덤프 등)
**/syslogs/
*.log
*.dmp

# OS
Thumbs.db
Desktop.ini
.DS_Store

# AI 도구(Claude) 관련 파일 — 저장소에 올리지 않음
CLAUDE.md
CLAUDE.local.md
.claude/
.mcp.json
Claude outputs/
skills/
client/escape_from_blockov/AgentScripts/
